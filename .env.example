# Copy to `.env` and fill in from your Supabase project's API settings.
# `.env` is gitignored; this example file is committed.
#
# The anon key is designed to be public — it is inlined into the JS bundle and
# gated by Row Level Security. Never put the service_role key in an EXPO_PUBLIC_
# variable; it bypasses RLS entirely.
#
# Restart the dev server after editing (EXPO_PUBLIC_* is inlined at build time).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
